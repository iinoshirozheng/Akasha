comptime _RANGES = _ranges()


def is_alphanumeric(codepoint: Int) -> Bool:
    var ranges = materialize[_RANGES]()
    var left = 0
    var right = 844
    while left < right:
        var middle = left + (right - left) // 2
        if codepoint < Int(ranges[middle * 2]):
            right = middle
        elif codepoint > Int(ranges[middle * 2 + 1]):
            left = middle + 1
        else:
            return True
    return False
