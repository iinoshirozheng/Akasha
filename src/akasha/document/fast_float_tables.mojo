def int_pow10() -> Array[UInt64, 16]:
    var result = Array[UInt64, 16](fill=0)
    result[0] = 1
    result[1] = 10
    result[2] = 100
    result[3] = 1000
    result[4] = 10000
    result[5] = 100000
    result[6] = 1000000
    result[7] = 10000000
    result[8] = 100000000
    result[9] = 1000000000
    result[10] = 10000000000
    result[11] = 100000000000
    result[12] = 1000000000000
    result[13] = 10000000000000
    result[14] = 100000000000000
    result[15] = 1000000000000000
    return result^

