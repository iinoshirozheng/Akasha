def is_whitespace(cp: Int) -> Bool:
    var group = cp >> 8
    if group == 0:
        return whitespace_map()[cp & 255] & 1 != 0
    if group == 22:
        return cp == 0x1680
    if group == 32:
        return whitespace_map()[cp & 255] & 2 != 0
    if group == 48:
        return cp == 0x3000
    return False
